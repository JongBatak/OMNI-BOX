'use client';

import React, { useRef } from 'react';
import gsap from 'gsap';
import { useGSAP } from '@gsap/react';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

if (typeof window !== 'undefined') {
  gsap.registerPlugin(ScrollTrigger);
}

// ─────────────────────────────────────────────────────────────
// DATA
// ─────────────────────────────────────────────────────────────
interface SectionData {
  number: string;
  label: string;
  tagline: string;
  headline: string;
  bgImage: string;
  labelColor: string;
}

const SECTIONS: SectionData[] = [
  {
    number: '01',
    label: 'Urban',
    tagline: 'Made to Last',
    headline: 'Signage, furniture, and equipment for welcoming urban spaces',
    bgImage: 'https://images.unsplash.com/photo-1486325212027-8081e485255e?q=80&w=1920&auto=format&fit=crop',
    labelColor: '#D96F3F',
  },
  {
    number: '02',
    label: 'Nature',
    tagline: 'Made to Last',
    headline: 'Signage and equipment for all facets of the great outdoors',
    bgImage: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?q=80&w=1920&auto=format&fit=crop',
    labelColor: '#4A7A4A',
  },
  {
    number: '03',
    label: 'Re:plastic',
    tagline: 'Made to Last',
    headline: 'Custom projects and furniture crafted out of 100% recyclable plastic',
    bgImage: 'https://images.unsplash.com/photo-1448375240586-882707db888b?q=80&w=1920&auto=format&fit=crop',
    labelColor: '#3A6B5A',
  },
  {
    number: '04',
    label: 'Golf',
    tagline: 'Made to Last',
    headline: 'Revamp your course with best practices golf equipment and signage',
    bgImage: 'https://images.unsplash.com/photo-1587174486073-ae5e5cff23aa?q=80&w=1920&auto=format&fit=crop',
    labelColor: '#5A8C40',
  },
  {
    number: '05',
    label: 'Details',
    tagline: 'Made to Last',
    headline: 'People and environment-friendly custom signage',
    bgImage: 'https://images.unsplash.com/photo-1518998053901-5348d3961a04?q=80&w=1920&auto=format&fit=crop',
    labelColor: '#9A7A50',
  },
];

// ─────────────────────────────────────────────────────────────
// NAVBAR
// ─────────────────────────────────────────────────────────────
function Navbar() {
  return (
    <nav className="fixed top-0 left-0 right-0 z-[200] flex items-center justify-between px-6 md:px-10 py-4 pointer-events-none mix-blend-difference text-white">
      <div className="pointer-events-auto flex items-center gap-2">
        <span className="text-xl font-light tracking-widest select-none" style={{ fontFamily: "'Cormorant Garamond', Georgia, serif" }}>
          Floema<span className="text-[10px] align-super font-normal">®</span>
        </span>
      </div>
      <div className="pointer-events-auto hidden md:flex items-center gap-8 text-[11px] font-semibold tracking-widest uppercase">
        <button className="hover:opacity-70 transition-opacity">Products</button>
        <button className="hover:opacity-70 transition-opacity">About</button>
        <button className="hover:opacity-70 transition-opacity">Sustainability</button>
        <button className="hover:opacity-70 transition-opacity">Journal</button>
        <button className="hover:opacity-70 transition-opacity">ENv</button>
      </div>
    </nav>
  );
}

// ─────────────────────────────────────────────────────────────
// MAIN ENGINE COMPONENT
// ─────────────────────────────────────────────────────────────
export default function FloemaStylePage() {
  const containerRef = useRef<HTMLDivElement>(null);
  const sectionRefs = useRef<(HTMLDivElement | null)[]>([]);
  const bgRefs = useRef<(HTMLDivElement | null)[]>([]);
  const contentRefs = useRef<(HTMLDivElement | null)[]>([]);
  const progressLineRef = useRef<HTMLDivElement>(null);

  useGSAP(() => {
    const sectionEls = sectionRefs.current.filter(Boolean) as HTMLDivElement[];
    const bgEls = bgRefs.current.filter(Boolean) as HTMLDivElement[];
    const contentEls = contentRefs.current.filter(Boolean) as HTMLDivElement[];

    const n = sectionEls.length;
    
    // Initial Layer Configuration
    sectionEls.forEach((el, i) => {
      gsap.set(el, { 
        zIndex: n - i,
        clipPath: 'inset(0% 0% 0% 0%)'
      });
      
      if (i > 0) {
        gsap.set(contentEls[i]?.children, { opacity: 0, y: 40 });
      }
    });

    // Background images start slightly shifted up for the rolling parallax canvas effect
    bgEls.forEach((bg, i) => {
      if (i > 0) gsap.set(bg, { yPercent: -15 });
    });

    const master = gsap.timeline({
      scrollTrigger: {
        trigger: containerRef.current,
        start: 'top top',
        end: `+=${(n - 1) * 130}%`, 
        scrub: 1.2, // Smooth scrubbing directly tied to your scroll wheel layout
        pin: true,
      },
    });

    // ── Continuous Rolling Canvas Loop ──
    for (let i = 1; i < n; i++) {
      const topSection = sectionEls[i - 1]; 
      const topContent = contentEls[i - 1]?.children; 
      const topBg = bgEls[i - 1];
      
      const bottomSection = sectionEls[i]; 
      const bottomBg = bgEls[i]; 
      const bottomContent = contentEls[i]?.children; 

      const stepLabel = `step-${i}`;

      // 1. The Rolling Seam: Outgoing section cleanly lifts away from bottom to top
      master.to(topSection, {
        clipPath: 'inset(0% 0% 100% 0%)',
        ease: 'none', 
        duration: 1.0
      }, stepLabel); 

      // 2. Continuous Parallax: Outgoing background rolls up out of the viewport frame
      master.to(topBg, {
        yPercent: 15,
        ease: 'none',
        duration: 1.0
      }, '<');

      // 3. Continuous Parallax: Incoming background unrolls beautifully into position
      master.to(bottomBg, {
        yPercent: 0,
        ease: 'none',
        duration: 1.0
      }, '<');

      // 4. Outgoing copy gracefully fades out ahead of the rolling seam line
      master.to(topContent as HTMLCollection, {
        y: -40,
        opacity: 0,
        stagger: 0.03,
        duration: 0.5,
        ease: 'power2.in',
      }, '<'); 

      // 5. Incoming copy rises into center screen with organic pacing
      master.to(bottomContent as HTMLCollection, {
        y: 0,
        opacity: 1,
        stagger: 0.05,
        duration: 0.6,
        ease: 'power2.out',
      }, `<+0.4`); // Delayed to enter naturally right as the split shifts past center

      // 6. Smooth timeline progress bar tracking
      master.to(progressLineRef.current, {
        width: `${(i / (n - 1)) * 100}%`,
        ease: 'none',
        duration: 1.0
      }, '<');
    }
  }, { scope: containerRef });

  return (
    <>
      <Navbar />

      {/* ── PINNED CONTAINER ── */}
      <div ref={containerRef} className="relative h-screen w-full bg-[#0a0a0a] overflow-hidden">
        
        {SECTIONS.map((section, index) => (
          <div
            key={section.number}
            ref={(el) => { sectionRefs.current[index] = el; }}
            className="absolute inset-0 w-full h-full will-change-[clip-path]"
          >
            {/* ── BACKGROUND PARALLAX LAYER ── */}
            <div
              ref={(el) => { bgRefs.current[index] = el; }}
              className="absolute w-full h-[130%] top-[-15%] will-change-transform"
              style={{
                backgroundImage: `url("${section.bgImage}")`,
                backgroundSize: 'cover',
                backgroundPosition: 'center',
              }}
            />
            {/* Dark editorial gradient tint for legibility */}
            <div className="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-black/50 z-[1]" />

            {/* ── CONTENT WRAPPER ── */}
            <div 
              ref={(el) => { contentRefs.current[index] = el; }}
              className="relative z-[2] flex flex-col items-center justify-center h-full w-full px-6"
            >
              
              {/* Number Layout (Left Alignment) */}
              <div className="absolute left-8 top-1/2 -translate-y-1/2 text-white/40 text-sm font-light">
                 {section.number}
              </div>

              {/* Tagline Structural Divider (Left Alignment) */}
               <div className="absolute left-8 top-[60%] flex flex-col items-center gap-4 text-white/40">
                 <div className="w-[1px] h-12 bg-white/20" />
                 <span className="text-[10px] tracking-[0.22em] uppercase origin-left -rotate-90 whitespace-nowrap mt-16">
                    {section.tagline}
                 </span>
              </div>

              {/* Central Pill Badge */}
              <div 
                 className="px-6 py-2 rounded-full border border-white/10 backdrop-blur-md bg-white/5 text-white text-[11px] font-semibold tracking-widest uppercase mb-6 flex items-center gap-2"
              >
                  <span className="w-1.5 h-1.5 rounded-full" style={{ backgroundColor: section.labelColor }} />
                  {section.label}
              </div>

              {/* Main Headline */}
              <h2 
                className="text-white leading-[1.12] text-center max-w-4xl font-normal drop-shadow-sm"
                style={{
                  fontFamily: "'Cormorant Garamond', Georgia, serif",
                  fontSize: 'clamp(2.4rem, 4.8vw, 4.2rem)',
                }}
              >
                {section.headline}
              </h2>
            </div>
          </div>
        ))}

        {/* ── CENTRAL PROGRESS TIMELINE BAR ── */}
        <div className="absolute left-1/2 -translate-x-1/2 bottom-12 w-[300px] h-[2px] bg-white/10 z-[100] mix-blend-difference pointer-events-none">
            <div 
                ref={progressLineRef}
                className="h-full bg-white will-change-[width]"
                style={{ width: '0%' }}
            />
        </div>
      </div>
    </>
  );
}
